{
  "name": "invoker",
  "version": "0.1.0",
  "description": "Minimal, typed AI tool invocation and streaming middleware powered by Effect and Zod.",
  "license": "MIT",
  "author": "WingSMC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WingSMC/invoker.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check && vp run typecheck && vp run site:check",
    "typecheck": "tsc --noEmit",
    "test": "vp test",
    "dev": "vp run build && vp dev --mode site",
    "test:watch": "vp test watch",
    "site:dev": "vp run build && vp dev --mode site",
    "site:build": "vp run build && vp build --mode site",
    "site:preview": "vp preview --mode site",
    "site:check": "svelte-check --tsconfig ./site/tsconfig.json",
    "test:e2e": "playwright test",
    "prepack": "vp run build",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/genai": "^2.27.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "effect": "^4.0.2",
    "openai": "^7.30.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "effect": "^4.0.2",
    "zod": "^4.6.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
