{
  "name": "invoker",
  "version": "0.1.0",
  "description": "Minimal, typed AI tool invocation and streaming middleware powered by Effect and Zod.",
  "license": "MIT",
  "author": "WingSMC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WingSMC/invoker.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check && vp run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vp test",
    "dev": "vp test watch",
    "prepack": "vp run build",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "effect": "^4.0.2",
    "openai": "^7.30.1",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "effect": "^4.0.2",
    "zod": "^4.6.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
